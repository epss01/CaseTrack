# Copy to .env ONLY in the production installation, never over a development .env.
APP_NAME=CaseTrack
APP_ENV=production
# FIRST INSTALL: generate locally with php artisan key:generate --force.
# EXISTING INSTALL: preserve its existing key; never copy the development key.
APP_KEY=
APP_DEBUG=false
APP_URL=https://INSTALL_HOSTNAME
# INSTALL: confirm the office timezone before entering real case dates.
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# INSTALL: dedicated MariaDB database/user, NOT the development database or root.
DB_CONNECTION=mysql
DB_HOST=INSTALL_DATABASE_HOST
DB_PORT=INSTALL_DATABASE_PORT
DB_DATABASE=INSTALL_DATABASE_NAME
DB_USERNAME=INSTALL_DATABASE_USER
DB_PASSWORD=
# INSTALL: set DB_PASSWORD securely in the installed .env; quote dotenv values.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
CACHE_PREFIX=casetrack_
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
